# RapidAPI key for spoonacular-recipe-food-nutrition-v1.p.rapidapi.com
SPOONACULAR_API_KEY=
# Gemini Developer API key (https://aistudio.google.com/apikey) — text stages + photo check
GEMINI_API_KEY=
# Image model (Nano Banana 2 Lite) and how to call it: batch (half price, up to 24 h) or live
IMAGE_MODEL=gemini-3.1-flash-lite-image
PHOTO_MODE=batch
# Give up waiting for a batch job after this many minutes (the job is resumed on the next run)
PHOTO_BATCH_WAIT_MINUTES=120
# Strongest model: final recipe reviewer + verification of every new ingredient row
REVIEW_MODEL=gemini-3.8-flash
STRONG_MODEL=gemini-3.8-flash
# USDA FoodData Central (nutrition fallback when CIQUAL has no match); DEMO_KEY is rate-limited
USDA_API_KEY=DEMO_KEY
# Firebase (upload). Uses Application Default Credentials unless a service account is set.
FIREBASE_PROJECT=tably-9f3c2
FIREBASE_STORAGE_BUCKET=tably-9f3c2.firebasestorage.app
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
