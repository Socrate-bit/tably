rules_version = '2';

// Tably security rules.
// A user may only read and write their own document and subcollections:
// profile, plan settings, shopping list and per-recipe state.
// The recipe catalogue ships inside the app, so no shared collection is
// readable or writable by clients — everything else is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);

      // userType is the paywall entitlement, so only the redeemReferralCode
      // function may set it. UserProfile.toMap() never emits the key, so a
      // legitimate client save always leaves it untouched.
      allow create: if isOwner(uid)
        && !('userType' in request.resource.data);

      // On an update request.resource.data is the document *after* the merge,
      // so it still carries an existing userType — checking the key is absent
      // would lock admins out of their own profile. Compare instead.
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userType']);

      match /{subcollection}/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Referral codes are readable so the client can pre-validate a code and
    // show a precise error; redemption itself is server-only.
    match /referralCodes/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
