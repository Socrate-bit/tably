rules_version = '2';

// Tably security rules.
// - A user may only read and write their own document and subcollections.
// - The recipe catalogue is world-readable but not client-writable in production.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Profile, weekly plan, shopping list and per-recipe state.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{subcollection}/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Shared catalogue. Writes are open only so the app can seed it on first
    // launch; tighten to `if false` once the catalogue is populated.
    match /recipes/{recipeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /cuisines/{cuisineId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
